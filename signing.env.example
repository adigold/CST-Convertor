# Copy this file to signing.env and fill in your own values.
# signing.env is ignored by git. Never commit it.
# Your app-specific password is NOT stored here. build.sh asks for it once
# and saves it in your Keychain.

APPLE_ID='you@example.com'
TEAM_ID='XXXXXXXXXX'

# Optional
# SIGN_IDENTITY='Developer ID Application: Your Name (XXXXXXXXXX)'
# NOTARY_PROFILE='cst-to-patch-notary'
